#!/usr/bin/env python3
"""fw2emu — helper for freewili2-emu.

  fw2emu run APP_DIR [EMULATOR FLAGS]   build one app folder for the emulator and run it
  fw2emu web APP_DIR [EMULATOR FLAGS]   build it for the browser and serve it on 127.0.0.1
  fw2emu test APP_DIR [EMULATOR FLAGS]  build it, run its test script headless, check the
                                        result (what the GitHub Action runs)
  fw2emu new DIR [--repo]               start a new app (with a test) from the template
  fw2emu hwcheck [APP_DIR ...]          build apps for the real FREE-WILi 2 (Pico SDK +
                                        Arm GCC) and report memory use and worst-case stack

Run `fw2emu COMMAND --help` for the options of each command.
"""

import argparse
import functools
import http.server
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse

TOOLS = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(TOOLS)
sys.path.insert(0, TOOLS)
import stackcheck  # noqa: E402

WILIBSP = os.path.join(ROOT, "third_party", "wilibsp")
PICO_SDK_VERSION = "2.3.0"          # what WiliBSP pins (tools/fw.py)
PICO_TOOLCHAIN_VERSION = "14_2_Rel1"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "fw2emu")

KB = 1024
# RP2350 memory map (Pico SDK 2.3.0 rp2350 default_locations.ld) and the
# FREE-WILi 2 app installer's windows (WiliBSP docs/app-storage.md).
RAM_BASE, RAM_SIZE = 0x20000000, 512 * KB
SCRATCH_X, SCRATCH_Y, SCRATCH_SIZE = 0x20080000, 0x20081000, 4 * KB
PSRAM_BASE, PSRAM_SIZE = 0x11000000, 8 * 1024 * KB
XIP_RAM_BASE, XIP_RAM_SIZE = 0x13FFC000, 16 * KB
FLASH_BASE, FLASH_END = 0x10000000, 0x11000000
INSTALL_SRAM_END = 0x20070000        # SRAM payload must sit in 0x20000000..0x20070000 (448 KB)


def die(msg, code=2):
    print(f"fw2emu: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    print("+ " + " ".join(cmd), file=sys.stderr, flush=True)
    return subprocess.run(cmd, **kw)


# --------------------------------------------------------------------- apps


def default_apps():
    """The apps the emulator builds: FW2_EMU_UPSTREAM_APPS plus apps/*."""
    with open(os.path.join(ROOT, "CMakeLists.txt")) as f:
        text = f.read()
    m = re.search(r"set\(_fw2_upstream_default\s+(.*?)\)", text, re.S)
    names = m.group(1).split() if m else []
    out = [os.path.join(WILIBSP, "apps", n) for n in names]
    local = os.path.join(ROOT, "apps")
    for n in sorted(os.listdir(local)):
        d = os.path.join(local, n)
        if os.path.isfile(os.path.join(d, "CMakeLists.txt")):
            out.append(d)
    return out


def check_app_dir(d):
    d = os.path.abspath(d)
    cml = os.path.join(d, "CMakeLists.txt")
    if not os.path.isfile(cml):
        die(f"{d}: no CMakeLists.txt")
    with open(cml) as f:
        text = f.read()
    targets = re.findall(r"fw2_(?:display|psram)_app\(\s*([A-Za-z0-9_.+-]+)", text)
    if not targets:
        die(f"{d}: CMakeLists.txt does not call fw2_display_app()")
    return d, targets


# --------------------------------------------------------------------- toolchain / SDK


ARM_TOOLCHAIN_RELEASE = "14.2.rel1"        # = WiliBSP's PICO_TOOLCHAIN_VERSION 14_2_Rel1
ARM_TOOLCHAIN_URL = ("https://developer.arm.com/-/media/Files/downloads/gnu/{rel}/binrel/"
                     "arm-gnu-toolchain-{rel}-{arch}-arm-none-eabi.tar.xz")


def _arm_toolchain_name():
    import platform
    arch = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}.get(
        platform.machine().lower())
    if not arch or not sys.platform.startswith("linux"):
        return None
    return f"arm-gnu-toolchain-{ARM_TOOLCHAIN_RELEASE}-{arch}-arm-none-eabi", arch


def fetch_toolchain():
    """Download the Arm GNU Toolchain 14.2.Rel1 into the cache (Linux x86_64/aarch64), verify its SHA-256."""
    import hashlib
    import tarfile
    import urllib.request
    na = _arm_toolchain_name()
    if not na:
        die("--fetch-toolchain supports Linux x86_64 / aarch64; install the Arm GNU Toolchain "
            f"{ARM_TOOLCHAIN_RELEASE} yourself and pass --toolchain")
    name, arch = na
    dest = os.path.join(CACHE, name)
    if os.access(os.path.join(dest, "bin", "arm-none-eabi-gcc"), os.X_OK):
        return dest
    url = ARM_TOOLCHAIN_URL.format(rel=ARM_TOOLCHAIN_RELEASE, arch=arch)
    os.makedirs(CACHE, exist_ok=True)
    archive = dest + ".tar.xz"
    print(f"fw2emu: downloading {url}", file=sys.stderr, flush=True)
    try:
        with urllib.request.urlopen(url + ".sha256asc") as r:
            want = r.read().decode().split()[0].lower()
        h = hashlib.sha256()
        with urllib.request.urlopen(url) as r, open(archive, "wb") as f:
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                h.update(chunk)
                f.write(chunk)
    except OSError as e:
        die(f"download failed: {e}")
    if h.hexdigest() != want:
        os.unlink(archive)
        die(f"checksum mismatch for {url}")
    tmp = dest + ".partial"
    shutil.rmtree(tmp, ignore_errors=True)
    with tarfile.open(archive) as t:
        t.extractall(tmp, **({"filter": "tar"} if hasattr(tarfile, "tar_filter") else {}))
    os.rename(os.path.join(tmp, name), dest)
    shutil.rmtree(tmp, ignore_errors=True)
    os.unlink(archive)
    return dest


def find_toolchain(explicit=None, fetch=False):
    """Directory holding arm-none-eabi-gcc, or exit with instructions."""
    cands = []
    if explicit:
        cands.append(explicit)
    if os.environ.get("PICO_TOOLCHAIN_PATH"):
        cands.append(os.environ["PICO_TOOLCHAIN_PATH"])
    cands.append(os.path.expanduser(f"~/.pico-sdk/toolchain/{PICO_TOOLCHAIN_VERSION}"))
    na = _arm_toolchain_name()
    if na:
        cands.append(os.path.join(CACHE, na[0]))
    for c in cands:
        for sub in ("bin", ""):
            gcc = os.path.join(c, sub, "arm-none-eabi-gcc")
            if os.access(gcc, os.X_OK):
                return os.path.abspath(os.path.dirname(gcc))
    if fetch:
        return os.path.abspath(os.path.join(fetch_toolchain(), "bin"))
    gcc = shutil.which("arm-none-eabi-gcc")
    if gcc:
        return os.path.dirname(os.path.realpath(gcc))
    die("arm-none-eabi-gcc not found.\n"
        "  tools/fw2emu hwcheck --fetch-toolchain   downloads the Arm GNU Toolchain 14.2.Rel1 WiliBSP uses\n"
        "  Debian/Ubuntu:  sudo apt install gcc-arm-none-eabi libnewlib-arm-none-eabi libstdc++-arm-none-eabi-newlib\n"
        "  Or install the Arm GNU Toolchain yourself and set PICO_TOOLCHAIN_PATH\n"
        "  to its directory (the one containing bin/arm-none-eabi-gcc).")


def gcc_version(bindir):
    try:
        out = subprocess.run([os.path.join(bindir, "arm-none-eabi-gcc"), "-dumpfullversion"],
                             capture_output=True, text=True).stdout.strip()
    except OSError:
        out = ""
    return out or "?"


def sdk_version(path):
    try:
        with open(os.path.join(path, "pico_sdk_version.cmake")) as f:
            t = f.read()
        v = [re.search(rf"set\(PICO_SDK_VERSION_{k} (\d+)\)", t).group(1) for k in ("MAJOR", "MINOR", "REVISION")]
        return ".".join(v)
    except (OSError, AttributeError):
        return None


def find_sdk(explicit=None, fetch=True):
    """PICO_SDK_PATH, else ~/.pico-sdk/sdk/2.3.0 (as WiliBSP's fw.py), else a clone in the cache."""
    for c in (explicit, os.environ.get("PICO_SDK_PATH"),
              os.path.expanduser(f"~/.pico-sdk/sdk/{PICO_SDK_VERSION}"),
              os.path.join(CACHE, f"pico-sdk-{PICO_SDK_VERSION}")):
        if c and os.path.isfile(os.path.join(c, "pico_sdk_init.cmake")):
            v = sdk_version(c)
            if v != PICO_SDK_VERSION:
                print(f"fw2emu: warning: Pico SDK at {c} is {v}; WiliBSP pins {PICO_SDK_VERSION}", file=sys.stderr)
            return os.path.abspath(c)
        if c and c in (explicit, os.environ.get("PICO_SDK_PATH")):
            die(f"{c}: not a Pico SDK checkout (no pico_sdk_init.cmake)")
    if not fetch:
        die("Pico SDK not found; set PICO_SDK_PATH")
    dest = os.path.join(CACHE, f"pico-sdk-{PICO_SDK_VERSION}")
    if not shutil.which("git"):
        die("Pico SDK not found and git is not installed to fetch it; set PICO_SDK_PATH")
    os.makedirs(CACHE, exist_ok=True)
    tmp = dest + ".partial"
    shutil.rmtree(tmp, ignore_errors=True)
    quiet = ["-c", "advice.detachedHead=false"]           # a tag checkout is expected here
    if run(["git"] + quiet + ["clone", "--quiet", "--depth", "1", "-b", PICO_SDK_VERSION,
            "https://github.com/raspberrypi/pico-sdk.git", tmp]).returncode:
        die("could not clone the Pico SDK")
    if run(["git"] + quiet + ["-C", tmp, "submodule", "update", "--init", "--depth", "1"]).returncode:
        die("could not fetch the Pico SDK submodules")
    os.rename(tmp, dest)
    return dest


def need_onewili():
    if not os.path.isfile(os.path.join(WILIBSP, "libs", "onewili", "CMakeLists.txt")):
        die("WiliBSP's libs/onewili submodule is missing (needed for hardware builds). Run:\n"
            "  git -C third_party/wilibsp submodule update --init --depth 1 libs/onewili")


# --------------------------------------------------------------------- memory


class Messages(list):
    """[{"level": "error"|"warn"|"note", "text": ...}]"""

    def append(self, level, text=None):
        if text is None:
            level, text = "note", level
        super().append(dict(level=level, text=text))


def region_of(addr):
    if RAM_BASE <= addr < RAM_BASE + RAM_SIZE:
        return "SRAM"
    if SCRATCH_X <= addr < SCRATCH_X + SCRATCH_SIZE:
        return "SCRATCH_X"
    if SCRATCH_Y <= addr < SCRATCH_Y + SCRATCH_SIZE:
        return "SCRATCH_Y"
    if PSRAM_BASE <= addr < PSRAM_BASE + PSRAM_SIZE:
        return "PSRAM"
    if XIP_RAM_BASE <= addr < XIP_RAM_BASE + XIP_RAM_SIZE:
        return "XIP_RAM"
    if FLASH_BASE <= addr < FLASH_END:
        return "FLASH"
    return "OTHER"


def _lma(elf, sec):
    """Load address of an allocated section (its address in the UF2), from the program headers."""
    for p in elf.segments:
        if p["type"] == elf.PT_LOAD and p["vaddr"] <= sec["addr"] < p["vaddr"] + max(p["memsz"], 1):
            return p["paddr"] + sec["addr"] - p["vaddr"]
    return sec["addr"]


def _kind(sec):
    if sec["flags"] & 0x1 or sec["name"].startswith((".data", ".tdata")):   # .data also holds .time_critical code
        return "data"
    if sec["flags"] & 0x4:                      # SHF_EXECINSTR
        return "code"
    return "rodata"


def memory_report(elf):
    """Sizes from the section and program headers of a linked app.

    fw2_display_app() images load into SRAM (no_flash). fw2_psram_app() images
    load into PSRAM and copy an SRAM bootstrap (.sram_bootstrap) and .data to
    SRAM at start-up (WiliBSP bsp/app/psram_link). Both are described by where
    each section is loaded (LMA) and where it runs (VMA).
    """
    alloc = [s for s in elf.sections if s["flags"] & elf.SHF_ALLOC and s["size"]]
    payload = {}           # region -> (bytes, lowest, highest end) of loadable bytes (UF2 content)
    for p in elf.segments:
        if p["type"] != elf.PT_LOAD or not p["filesz"]:
            continue
        r = region_of(p["paddr"])
        b, lo, hi = payload.get(r, (0, p["paddr"], p["paddr"]))
        payload[r] = (b + p["filesz"], min(lo, p["paddr"]), max(hi, p["paddr"] + p["filesz"]))
    sections = []
    for s in alloc:
        load = s["type"] != elf.SHT_NOBITS
        lma = _lma(elf, s) if load else s["addr"]
        sections.append(dict(name=s["name"], addr=s["addr"], lma=lma, size=s["size"], load=load,
                             kind=_kind(s), region=region_of(s["addr"]), load_region=region_of(lma)))

    image_region = "PSRAM" if "PSRAM" in payload and "SRAM" not in payload else "SRAM"
    base, window = ((PSRAM_BASE, PSRAM_SIZE) if image_region == "PSRAM"
                    else (RAM_BASE, INSTALL_SRAM_END - RAM_BASE))
    b, lo, hi = payload.get(image_region, (0, base, base))
    image_parts = {}
    copied = {}            # loaded in the image, run from SRAM (copied at start-up)
    for s in sections:
        if s["load"] and s["load_region"] == image_region:
            k = "bootstrap" if s["name"] == ".sram_bootstrap" else s["kind"]
            if s["region"] == "SRAM" and image_region == "PSRAM":
                copied[s["name"]] = s["size"]
            image_parts[k] = image_parts.get(k, 0) + s["size"]

    stack_top = elf.symbol("__StackTop") or SCRATCH_Y + SCRATCH_SIZE
    # A stack top inside main SRAM (fw2_psram_app: 0x20070000, below the
    # DISPLAY loader's reserved SRAM) also caps what the app may use there.
    ram_limit = (stack_top - RAM_BASE) if RAM_BASE < stack_top <= RAM_BASE + RAM_SIZE else RAM_SIZE
    sram = [s for s in sections if s["region"] == "SRAM"]
    ram_parts = {}
    for s in sram:
        k = ("bootstrap" if s["name"] == ".sram_bootstrap" else "heap" if s["name"] == ".heap"
             else s["kind"] if s["load"] else "bss")
        ram_parts[k] = ram_parts.get(k, 0) + s["size"]
    heap_start = elf.symbol("__end__")
    # The SDK's _sbrk (pico_clib_interface) stops at __StackLimit ("historically
    # the maximum heap pointer"), not at __StackTop.
    heap_limit = elf.symbol("__StackLimit") or elf.symbol("__HeapLimit") or RAM_BASE + RAM_SIZE
    heap_end = min(heap_limit, stack_top) if RAM_BASE < stack_top <= RAM_BASE + RAM_SIZE else heap_limit
    psram_sec = [s for s in sections if s["region"] == "PSRAM"]
    return dict(
        payload={r: dict(bytes=b_, start=lo_, end=hi_) for r, (b_, lo_, hi_) in payload.items()},
        image=dict(region=image_region, bytes=b, extent=hi - base if b else 0, limit=window,
                   breakdown=image_parts, copied_to_sram=copied),
        ram=dict(used=max((s["addr"] + s["size"] - RAM_BASE for s in sram), default=0), limit=ram_limit,
                 breakdown=ram_parts, heap_start=heap_start, heap_limit=heap_limit,
                 heap_free=(heap_end - heap_start) if heap_start else None),
        psram=dict(used=max((s["addr"] + s["size"] - PSRAM_BASE for s in psram_sec), default=0),
                   noload=sum(s["size"] for s in psram_sec if not s["load"]),
                   load=sum(s["size"] for s in psram_sec if s["load"]), limit=PSRAM_SIZE),
        stack_top=stack_top,
        scratch_x_data=sum(s["size"] for s in sections if s["region"] == "SCRATCH_X" and not s["name"].startswith(".stack")),
        scratch_y_data=sum(s["size"] for s in sections if s["region"] == "SCRATCH_Y" and not s["name"].startswith(".stack")),
        sections=sections,
    )


def stack_budget(elf, mem, stack):
    """Compare the worst-case stack with the memory below the stack top. Returns (status, messages, budget).

    The layout comes from the linked ELF: __StackTop is the initial MSP. The
    Pico SDK puts it at the top of SCRATCH_Y (0x20082000); WiliBSP's
    fw2_psram_app() link sets it to 0x20070000 in main SRAM.
    """
    msgs, status = Messages(), "ok"
    top0 = mem["stack_top"]
    top1 = elf.symbol("__StackOneTop") or SCRATCH_X + SCRATCH_SIZE
    x_free = top1 - (SCRATCH_X + mem["scratch_x_data"])
    core1 = stack["core1_launched"]
    need = stack["combined"]
    if SCRATCH_Y < top0 <= SCRATCH_Y + SCRATCH_SIZE:
        y_free = top0 - (SCRATCH_Y + mem["scratch_y_data"])
        budget = dict(region="SCRATCH_Y", top=top0, limit=y_free,
                      hard_limit=y_free if core1 else y_free + x_free)
        if need > budget["hard_limit"]:
            status = "error"
            if core1:
                msgs.append("error", f"core 0 stack {need} B overflows SCRATCH_Y ({y_free} B) into core 1's stack")
            else:
                msgs.append("error", f"core 0 stack {need} B overflows both scratch banks ({y_free + x_free} B) "
                            "into the top of RAM, where the heap ends; there is no stack guard")
        elif need > y_free:
            status = "warn"
            msgs.append("warn", f"core 0 stack {need} B exceeds SCRATCH_Y ({y_free} B) and is using SCRATCH_X, "
                        "core 1's stack region (fine only while core 1 is not launched)")
    elif RAM_BASE < top0 <= RAM_BASE + RAM_SIZE:
        floor = RAM_BASE + mem["ram"]["used"]          # end of .bss + .heap reserve
        gap = top0 - floor
        budget = dict(region="SRAM", top=top0, limit=gap, hard_limit=gap)
        if need > gap:
            status = "error"
            msgs.append("error", f"core 0 stack {need} B does not fit between static RAM (ends 0x{floor:08x}) "
                        f"and the stack top 0x{top0:08x} ({gap} B)")
        hl = mem["ram"]["heap_limit"]
        if stack.get("uses_malloc") and hl > top0:
            if status == "ok":
                status = "warn"
            msgs.append("warn", f"malloc (the SDK's _sbrk) may grow up to __StackLimit 0x{hl:08x}, past the "
                        f"stack top 0x{top0:08x}: a large heap runs into the stack, and beyond it into SRAM "
                        "the DISPLAY loader reserves; nothing stops it")
    else:
        budget = dict(region=region_of(top0), top=top0, limit=0, hard_limit=0)
        status = "error"
        msgs.append("error", f"initial stack pointer __StackTop 0x{top0:08x} is not in SRAM")
    for c in stack["core1"]:
        if c["bytes"] + stack["exception_frame"] > x_free:
            status = "error"
            msgs.append("error", f"core 1 stack ({c['name']}) {c['bytes']} B + exception frame overflows SCRATCH_X ({x_free} B)")
    return status, msgs, budget


def check_elf(elf_path, build_dir, bindir=None):
    elf = stackcheck.Elf(elf_path)
    mem = memory_report(elf)
    objdump = os.path.join(bindir, "arm-none-eabi-objdump") if bindir else None
    st = stackcheck.analyse(elf_path, build_dir, objdump)
    msgs, status = Messages(), "ok"

    def bump(s):
        nonlocal status
        order = {"ok": 0, "warn": 1, "error": 2}
        if order[s] > order[status]:
            status = s

    regions = set(mem["payload"])
    if "FLASH" in regions:
        bump("error"); msgs.append("error", "image has payload in QSPI flash; the app installer rejects it")
    if "PSRAM" in regions and regions & {"SRAM", "SCRATCH_X", "SCRATCH_Y", "XIP_RAM"}:
        bump("error"); msgs.append("error", "image mixes SRAM and PSRAM payload; the app installer rejects it")
    for r in regions & {"SCRATCH_X", "SCRATCH_Y", "XIP_RAM", "OTHER"}:
        bump("error"); msgs.append("error", f"image has payload in {r} ({mem['payload'][r]['bytes']} B), outside the "
                                   "installer's windows")
    img = mem["image"]
    if img["extent"] > img["limit"]:
        where = ("the installer's 448 KB SRAM window (0x20000000..0x20070000)" if img["region"] == "SRAM"
                 else "the 8 MB PSRAM window")
        bump("error"); msgs.append("error", f"{img['region']} image extends {img['extent'] / KB:.1f} KB, beyond {where}")
    if mem["ram"]["used"] > mem["ram"]["limit"]:
        bump("error"); msgs.append("error", f"static SRAM use {mem['ram']['used'] / KB:.1f} KB exceeds "
                                   f"{mem['ram']['limit'] / KB:.0f} KB")
    if mem["psram"]["used"] > mem["psram"]["limit"]:
        bump("error"); msgs.append("error", "PSRAM use exceeds 8 MB")
    st["core1_launched"] = bool(st["core1"]) or st.get("core1_launch_sites", 0) > 0
    s, m, budget = stack_budget(elf, mem, st)
    bump(s); msgs.extend(m)
    if st["irq_priorities_changed"]:
        msgs.append("note", "the app changes IRQ priorities (" + ", ".join(st["irq_priorities_changed"]) +
                    "): nested interrupts can stack deeper than the figure above")
    return dict(elf=elf_path, status=status, messages=msgs, memory=mem, stack=st, stack_budget=budget)


# --------------------------------------------------------------------- run / web


def _generator():
    return ["-G", "Ninja"] if shutil.which("ninja") else []


def build_one_app(app_dir, build, cmake_args, web=False):
    """Configure the emulator with only APP_DIR and build its target. Returns (target, bin dir)."""
    app_dir, targets = check_app_dir(app_dir)
    target = targets[0]
    if len(targets) > 1:
        print(f"fw2emu: {app_dir} defines {', '.join(targets)}; using {target}", file=sys.stderr)
    if not os.path.isfile(os.path.join(WILIBSP, "bsp", "fw2.h")):
        die("WiliBSP is missing; run: git submodule update --init --recursive")
    cfg = ["cmake", "-S", ROOT, "-B", build] + _generator() + [
        "-DFW2_EMU_UPSTREAM_APPS=", "-DFW2_EMU_LOCAL_APPS=OFF", "-DFW2_EMU_TEST_APPS=OFF",
        f"-DFW2_EMU_EXTRA_APPS={app_dir}"] + cmake_args
    if web:
        cfg = ["emcmake"] + cfg
    if run(cfg, stdout=subprocess.DEVNULL).returncode:
        die("configure failed (run the command above yourself to see why)", 1)
    if run(["cmake", "--build", build, "--target", target]).returncode:
        die("build failed", 1)
    return target, os.path.join(build, "bin")


def cmd_run(a):
    cmake_args, suffix = [], ""
    if a.sanitize:
        cmake_args.append("-DFW2_EMU_SANITIZE=ON"); suffix += "-asan"
    if a.m32:
        cmake_args.append("-DFW2_EMU_32BIT=ON"); suffix += "-m32"
    if a.debug or a.gdb:
        cmake_args.append("-DCMAKE_BUILD_TYPE=Debug"); suffix += "-debug"
    build = os.path.abspath(a.build_dir or os.path.join(ROOT, "build-run" + suffix))
    target, bindir = build_one_app(a.app, build, cmake_args)
    exe = os.path.join(bindir, target)
    # bin/current-app always points at the app built last, so a debugger
    # configuration (e.g. .vscode/launch.json) needs no per-app path.
    link = os.path.join(bindir, "current-app")
    try:
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(target, link)
    except OSError:
        pass
    if a.build_only:
        print(exe)
        return 0
    args = a.emu_args[1:] if a.emu_args[:1] == ["--"] else a.emu_args
    if a.m32 and "--headless" not in args:
        print("fw2emu: note: the -m32 build has no window unless configured with SDL; adding --headless",
              file=sys.stderr)
        args = ["--headless"] + args
    # Without a display the emulator switches to headless by itself and says so.
    cmd = ["gdb", "-q", "-ex", "break fw2_emu_app_main", "--args", exe] + args if a.gdb else [exe] + args
    if a.gdb and not shutil.which("gdb"):
        die("gdb not found")
