#!/usr/bin/env python3
"""fw2emu — helper for freewili2-emu.

  fw2emu run APP_DIR [EMULATOR FLAGS]   build one app folder for the emulator and run it
  fw2emu web APP_DIR [EMULATOR FLAGS]   build it for the browser and serve it on 127.0.0.1
  fw2emu hwcheck [APP_DIR ...]          build apps for the real FREE-WILi 2 (Pico SDK +
                                        Arm GCC) and report memory use and worst-case stack

Run `fw2emu COMMAND --help` for the options of each command.
"""

import argparse
import functools
import http.server
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse

TOOLS = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(TOOLS)
sys.path.insert(0, TOOLS)
import stackcheck  # noqa: E402

WILIBSP = os.path.join(ROOT, "third_party", "wilibsp")
PICO_SDK_VERSION = "2.3.0"          # what WiliBSP pins (tools/fw.py)
PICO_TOOLCHAIN_VERSION = "14_2_Rel1"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "fw2emu")

KB = 1024
# RP2350 memory map (Pico SDK 2.3.0 rp2350 default_locations.ld) and the
# FREE-WILi 2 app installer's windows (WiliBSP docs/app-storage.md).
RAM_BASE, RAM_SIZE = 0x20000000, 512 * KB
SCRATCH_X, SCRATCH_Y, SCRATCH_SIZE = 0x20080000, 0x20081000, 4 * KB
PSRAM_BASE, PSRAM_SIZE = 0x11000000, 8 * 1024 * KB
XIP_RAM_BASE, XIP_RAM_SIZE = 0x13FFC000, 16 * KB
FLASH_BASE, FLASH_END = 0x10000000, 0x11000000
INSTALL_SRAM_END = 0x20070000        # SRAM payload must sit in 0x20000000..0x20070000 (448 KB)


def die(msg, code=2):
    print(f"fw2emu: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    print("+ " + " ".join(cmd), file=sys.stderr, flush=True)
    return subprocess.run(cmd, **kw)


# --------------------------------------------------------------------- apps


def default_apps():
    """The apps the emulator builds: FW2_EMU_UPSTREAM_APPS plus apps/*."""
    with open(os.path.join(ROOT, "CMakeLists.txt")) as f:
        text = f.read()
    m = re.search(r"set\(_fw2_upstream_default\s+(.*?)\)", text, re.S)
    names = m.group(1).split() if m else []
    out = [os.path.join(WILIBSP, "apps", n) for n in names]
    local = os.path.join(ROOT, "apps")
    for n in sorted(os.listdir(local)):
        d = os.path.join(local, n)
        if os.path.isfile(os.path.join(d, "CMakeLists.txt")):
            out.append(d)
    return out


def check_app_dir(d):
    d = os.path.abspath(d)
    cml = os.path.join(d, "CMakeLists.txt")
    if not os.path.isfile(cml):
        die(f"{d}: no CMakeLists.txt")
    with open(cml) as f:
        text = f.read()
    targets = re.findall(r"fw2_(?:display|psram)_app\(\s*([A-Za-z0-9_.+-]+)", text)
    if not targets:
        die(f"{d}: CMakeLists.txt does not call fw2_display_app()")
    return d, targets


# --------------------------------------------------------------------- toolchain / SDK


ARM_TOOLCHAIN_RELEASE = "14.2.rel1"        # = WiliBSP's PICO_TOOLCHAIN_VERSION 14_2_Rel1
ARM_TOOLCHAIN_URL = ("https://developer.arm.com/-/media/Files/downloads/gnu/{rel}/binrel/"
                     "arm-gnu-toolchain-{rel}-{arch}-arm-none-eabi.tar.xz")


def _arm_toolchain_name():
    import platform
    arch = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}.get(
        platform.machine().lower())
    if not arch or not sys.platform.startswith("linux"):
        return None
    return f"arm-gnu-toolchain-{ARM_TOOLCHAIN_RELEASE}-{arch}-arm-none-eabi", arch


def fetch_toolchain():
    """Download the Arm GNU Toolchain 14.2.Rel1 into the cache (Linux x86_64/aarch64), verify its SHA-256."""
    import hashlib
    import tarfile
    import urllib.request
    na = _arm_toolchain_name()
    if not na:
        die("--fetch-toolchain supports Linux x86_64 / aarch64; install the Arm GNU Toolchain "
            f"{ARM_TOOLCHAIN_RELEASE} yourself and pass --toolchain")
    name, arch = na
    dest = os.path.join(CACHE, name)
    if os.access(os.path.join(dest, "bin", "arm-none-eabi-gcc"), os.X_OK):
        return dest
    url = ARM_TOOLCHAIN_URL.format(rel=ARM_TOOLCHAIN_RELEASE, arch=arch)
    os.makedirs(CACHE, exist_ok=True)
    archive = dest + ".tar.xz"
    print(f"fw2emu: downloading {url}", file=sys.stderr, flush=True)
    try:
        with urllib.request.urlopen(url + ".sha256asc") as r:
            want = r.read().decode().split()[0].lower()
        h = hashlib.sha256()
        with urllib.request.urlopen(url) as r, open(archive, "wb") as f:
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                h.update(chunk)
                f.write(chunk)
    except OSError as e:
        die(f"download failed: {e}")
    if h.hexdigest() != want:
        os.unlink(archive)
        die(f"checksum mismatch for {url}")
    tmp = dest + ".partial"
    shutil.rmtree(tmp, ignore_errors=True)
    with tarfile.open(archive) as t:
        t.extractall(tmp, **({"filter": "tar"} if hasattr(tarfile, "tar_filter") else {}))
    os.rename(os.path.join(tmp, name), dest)
    shutil.rmtree(tmp, ignore_errors=True)
    os.unlink(archive)
    return dest


def find_toolchain(explicit=None, fetch=False):
    """Directory holding arm-none-eabi-gcc, or exit with instructions."""
    cands = []
    if explicit:
        cands.append(explicit)
    if os.environ.get("PICO_TOOLCHAIN_PATH"):
        cands.append(os.environ["PICO_TOOLCHAIN_PATH"])
    cands.append(os.path.expanduser(f"~/.pico-sdk/toolchain/{PICO_TOOLCHAIN_VERSION}"))
    na = _arm_toolchain_name()
    if na:
        cands.append(os.path.join(CACHE, na[0]))
    for c in cands:
        for sub in ("bin", ""):
            gcc = os.path.join(c, sub, "arm-none-eabi-gcc")
            if os.access(gcc, os.X_OK):
                return os.path.dirname(gcc)
    if fetch:
        return os.path.join(fetch_toolchain(), "bin")
    gcc = shutil.which("arm-none-eabi-gcc")
    if gcc:
        return os.path.dirname(os.path.realpath(gcc))
    die("arm-none-eabi-gcc not found.\n"
        "  tools/fw2emu hwcheck --fetch-toolchain   downloads the Arm GNU Toolchain 14.2.Rel1 WiliBSP uses\n"
        "  Debian/Ubuntu:  sudo apt install gcc-arm-none-eabi libnewlib-arm-none-eabi libstdc++-arm-none-eabi-newlib\n"
        "  Or install the Arm GNU Toolchain yourself and set PICO_TOOLCHAIN_PATH\n"
        "  to its directory (the one containing bin/arm-none-eabi-gcc).")


def gcc_version(bindir):
    try:
        out = subprocess.run([os.path.join(bindir, "arm-none-eabi-gcc"), "-dumpfullversion"],
                             capture_output=True, text=True).stdout.strip()
    except OSError:
        out = ""
    return out or "?"


def sdk_version(path):
    try:
        with open(os.path.join(path, "pico_sdk_version.cmake")) as f:
            t = f.read()
        v = [re.search(rf"set\(PICO_SDK_VERSION_{k} (\d+)\)", t).group(1) for k in ("MAJOR", "MINOR", "REVISION")]
        return ".".join(v)
    except (OSError, AttributeError):
        return None


def find_sdk(explicit=None, fetch=True):
    """PICO_SDK_PATH, else ~/.pico-sdk/sdk/2.3.0 (as WiliBSP's fw.py), else a clone in the cache."""
    for c in (explicit, os.environ.get("PICO_SDK_PATH"),
              os.path.expanduser(f"~/.pico-sdk/sdk/{PICO_SDK_VERSION}"),
              os.path.join(CACHE, f"pico-sdk-{PICO_SDK_VERSION}")):
        if c and os.path.isfile(os.path.join(c, "pico_sdk_init.cmake")):
            v = sdk_version(c)
            if v != PICO_SDK_VERSION:
                print(f"fw2emu: warning: Pico SDK at {c} is {v}; WiliBSP pins {PICO_SDK_VERSION}", file=sys.stderr)
            return os.path.abspath(c)
        if c and c in (explicit, os.environ.get("PICO_SDK_PATH")):
            die(f"{c}: not a Pico SDK checkout (no pico_sdk_init.cmake)")
    if not fetch:
        die("Pico SDK not found; set PICO_SDK_PATH")
    dest = os.path.join(CACHE, f"pico-sdk-{PICO_SDK_VERSION}")
    if not shutil.which("git"):
        die("Pico SDK not found and git is not installed to fetch it; set PICO_SDK_PATH")
    os.makedirs(CACHE, exist_ok=True)
    tmp = dest + ".partial"
    shutil.rmtree(tmp, ignore_errors=True)
    if run(["git", "clone", "--quiet", "--depth", "1", "-b", PICO_SDK_VERSION,
            "https://github.com/raspberrypi/pico-sdk.git", tmp]).returncode:
        die("could not clone the Pico SDK")
    if run(["git", "-C", tmp, "submodule", "update", "--init", "--depth", "1"]).returncode:
        die("could not fetch the Pico SDK submodules")
    os.rename(tmp, dest)
    return dest


def need_onewili():
    if not os.path.isfile(os.path.join(WILIBSP, "libs", "onewili", "CMakeLists.txt")):
        die("WiliBSP's libs/onewili submodule is missing (needed for hardware builds). Run:\n"
            "  git -C third_party/wilibsp submodule update --init --depth 1 libs/onewili")


# --------------------------------------------------------------------- memory


class Messages(list):
    """[{"level": "error"|"warn"|"note", "text": ...}]"""

    def append(self, level, text=None):
        if text is None:
            level, text = "note", level
        super().append(dict(level=level, text=text))


def region_of(addr):
    if RAM_BASE <= addr < RAM_BASE + RAM_SIZE:
        return "SRAM"
    if SCRATCH_X <= addr < SCRATCH_X + SCRATCH_SIZE:
        return "SCRATCH_X"
    if SCRATCH_Y <= addr < SCRATCH_Y + SCRATCH_SIZE:
        return "SCRATCH_Y"
    if PSRAM_BASE <= addr < PSRAM_BASE + PSRAM_SIZE:
        return "PSRAM"
    if XIP_RAM_BASE <= addr < XIP_RAM_BASE + XIP_RAM_SIZE:
        return "XIP_RAM"
    if FLASH_BASE <= addr < FLASH_END:
        return "FLASH"
    return "OTHER"


def _lma(elf, sec):
    """Load address of an allocated section (its address in the UF2), from the program headers."""
    for p in elf.segments:
        if p["type"] == elf.PT_LOAD and p["vaddr"] <= sec["addr"] < p["vaddr"] + max(p["memsz"], 1):
            return p["paddr"] + sec["addr"] - p["vaddr"]
    return sec["addr"]


def _kind(sec):
    if sec["flags"] & 0x1 or sec["name"].startswith((".data", ".tdata")):   # .data also holds .time_critical code
        return "data"
    if sec["flags"] & 0x4:                      # SHF_EXECINSTR
        return "code"
    return "rodata"


def memory_report(elf):
    """Sizes from the section and program headers of a linked app.

    fw2_display_app() images load into SRAM (no_flash). fw2_psram_app() images
    load into PSRAM and copy an SRAM bootstrap (.sram_bootstrap) and .data to
    SRAM at start-up (WiliBSP bsp/app/psram_link). Both are described by where
    each section is loaded (LMA) and where it runs (VMA).
    """
    alloc = [s for s in elf.sections if s["flags"] & elf.SHF_ALLOC and s["size"]]
    payload = {}           # region -> (bytes, lowest, highest end) of loadable bytes (UF2 content)
    for p in elf.segments:
        if p["type"] != elf.PT_LOAD or not p["filesz"]:
            continue
        r = region_of(p["paddr"])
        b, lo, hi = payload.get(r, (0, p["paddr"], p["paddr"]))
        payload[r] = (b + p["filesz"], min(lo, p["paddr"]), max(hi, p["paddr"] + p["filesz"]))
    sections = []
    for s in alloc:
        load = s["type"] != elf.SHT_NOBITS
        lma = _lma(elf, s) if load else s["addr"]
        sections.append(dict(name=s["name"], addr=s["addr"], lma=lma, size=s["size"], load=load,
                             kind=_kind(s), region=region_of(s["addr"]), load_region=region_of(lma)))

    image_region = "PSRAM" if "PSRAM" in payload and "SRAM" not in payload else "SRAM"
    base, window = ((PSRAM_BASE, PSRAM_SIZE) if image_region == "PSRAM"
                    else (RAM_BASE, INSTALL_SRAM_END - RAM_BASE))
    b, lo, hi = payload.get(image_region, (0, base, base))
    image_parts = {}
    copied = {}            # loaded in the image, run from SRAM (copied at start-up)
    for s in sections:
        if s["load"] and s["load_region"] == image_region:
            k = "bootstrap" if s["name"] == ".sram_bootstrap" else s["kind"]
            if s["region"] == "SRAM" and image_region == "PSRAM":
                copied[s["name"]] = s["size"]
            image_parts[k] = image_parts.get(k, 0) + s["size"]

    stack_top = elf.symbol("__StackTop") or SCRATCH_Y + SCRATCH_SIZE
    # A stack top inside main SRAM (fw2_psram_app: 0x20070000, below the
    # DISPLAY loader's reserved SRAM) also caps what the app may use there.
    ram_limit = (stack_top - RAM_BASE) if RAM_BASE < stack_top <= RAM_BASE + RAM_SIZE else RAM_SIZE
    sram = [s for s in sections if s["region"] == "SRAM"]
    ram_parts = {}
    for s in sram:
        k = ("bootstrap" if s["name"] == ".sram_bootstrap" else "heap" if s["name"] == ".heap"
             else s["kind"] if s["load"] else "bss")
        ram_parts[k] = ram_parts.get(k, 0) + s["size"]
    heap_start = elf.symbol("__end__")
    # The SDK's _sbrk (pico_clib_interface) stops at __StackLimit ("historically
    # the maximum heap pointer"), not at __StackTop.
    heap_limit = elf.symbol("__StackLimit") or elf.symbol("__HeapLimit") or RAM_BASE + RAM_SIZE
    heap_end = min(heap_limit, stack_top) if RAM_BASE < stack_top <= RAM_BASE + RAM_SIZE else heap_limit
    psram_sec = [s for s in sections if s["region"] == "PSRAM"]
    return dict(
        payload={r: dict(bytes=b_, start=lo_, end=hi_) for r, (b_, lo_, hi_) in payload.items()},
        image=dict(region=image_region, bytes=b, extent=hi - base if b else 0, limit=window,
                   breakdown=image_parts, copied_to_sram=copied),
        ram=dict(used=max((s["addr"] + s["size"] - RAM_BASE for s in sram), default=0), limit=ram_limit,
                 breakdown=ram_parts, heap_start=heap_start, heap_limit=heap_limit,
                 heap_free=(heap_end - heap_start) if heap_start else None),
        psram=dict(used=max((s["addr"] + s["size"] - PSRAM_BASE for s in psram_sec), default=0),
                   noload=sum(s["size"] for s in psram_sec if not s["load"]),
                   load=sum(s["size"] for s in psram_sec if s["load"]), limit=PSRAM_SIZE),
        stack_top=stack_top,
        scratch_x_data=sum(s["size"] for s in sections if s["region"] == "SCRATCH_X" and not s["name"].startswith(".stack")),
        scratch_y_data=sum(s["size"] for s in sections if s["region"] == "SCRATCH_Y" and not s["name"].startswith(".stack")),
        sections=sections,
    )


def stack_budget(elf, mem, stack):
    """Compare the worst-case stack with the memory below the stack top. Returns (status, messages, budget).

    The layout comes from the linked ELF: __StackTop is the initial MSP. The
    Pico SDK puts it at the top of SCRATCH_Y (0x20082000); WiliBSP's
    fw2_psram_app() link sets it to 0x20070000 in main SRAM.
    """
    msgs, status = Messages(), "ok"
    top0 = mem["stack_top"]
    top1 = elf.symbol("__StackOneTop") or SCRATCH_X + SCRATCH_SIZE
    x_free = top1 - (SCRATCH_X + mem["scratch_x_data"])
    core1 = stack["core1_launched"]
    need = stack["combined"]
    if SCRATCH_Y < top0 <= SCRATCH_Y + SCRATCH_SIZE:
        y_free = top0 - (SCRATCH_Y + mem["scratch_y_data"])
        budget = dict(region="SCRATCH_Y", top=top0, limit=y_free,
                      hard_limit=y_free if core1 else y_free + x_free)
        if need > budget["hard_limit"]:
            status = "error"
            if core1:
                msgs.append("error", f"core 0 stack {need} B overflows SCRATCH_Y ({y_free} B) into core 1's stack")
            else:
                msgs.append("error", f"core 0 stack {need} B overflows both scratch banks ({y_free + x_free} B) "
                            "into the top of RAM, where the heap ends; there is no stack guard")
        elif need > y_free:
            status = "warn"
            msgs.append("warn", f"core 0 stack {need} B exceeds SCRATCH_Y ({y_free} B) and is using SCRATCH_X, "
                        "core 1's stack region (fine only while core 1 is not launched)")
    elif RAM_BASE < top0 <= RAM_BASE + RAM_SIZE:
        floor = RAM_BASE + mem["ram"]["used"]          # end of .bss + .heap reserve
        gap = top0 - floor
        budget = dict(region="SRAM", top=top0, limit=gap, hard_limit=gap)
        if need > gap:
            status = "error"
            msgs.append("error", f"core 0 stack {need} B does not fit between static RAM (ends 0x{floor:08x}) "
                        f"and the stack top 0x{top0:08x} ({gap} B)")
        hl = mem["ram"]["heap_limit"]
        if stack.get("uses_malloc") and hl > top0:
            if status == "ok":
                status = "warn"
            msgs.append("warn", f"malloc (the SDK's _sbrk) may grow up to __StackLimit 0x{hl:08x}, past the "
                        f"stack top 0x{top0:08x}: a large heap runs into the stack, and beyond it into SRAM "
                        "the DISPLAY loader reserves; nothing stops it")
    else:
        budget = dict(region=region_of(top0), top=top0, limit=0, hard_limit=0)
        status = "error"
        msgs.append("error", f"initial stack pointer __StackTop 0x{top0:08x} is not in SRAM")
    for c in stack["core1"]:
        if c["bytes"] + stack["exception_frame"] > x_free:
            status = "error"
            msgs.append("error", f"core 1 stack ({c['name']}) {c['bytes']} B + exception frame overflows SCRATCH_X ({x_free} B)")
    return status, msgs, budget


def check_elf(elf_path, build_dir, bindir=None):
    elf = stackcheck.Elf(elf_path)
    mem = memory_report(elf)
    objdump = os.path.join(bindir, "arm-none-eabi-objdump") if bindir else None
    st = stackcheck.analyse(elf_path, build_dir, objdump)
    msgs, status = Messages(), "ok"

    def bump(s):
        nonlocal status
        order = {"ok": 0, "warn": 1, "error": 2}
        if order[s] > order[status]:
            status = s

    regions = set(mem["payload"])
    if "FLASH" in regions:
        bump("error"); msgs.append("error", "image has payload in QSPI flash; the app installer rejects it")
    if "PSRAM" in regions and regions & {"SRAM", "SCRATCH_X", "SCRATCH_Y", "XIP_RAM"}:
        bump("error"); msgs.append("error", "image mixes SRAM and PSRAM payload; the app installer rejects it")
    for r in regions & {"SCRATCH_X", "SCRATCH_Y", "XIP_RAM", "OTHER"}:
        bump("error"); msgs.append("error", f"image has payload in {r} ({mem['payload'][r]['bytes']} B), outside the "
                                   "installer's windows")
    img = mem["image"]
    if img["extent"] > img["limit"]:
        where = ("the installer's 448 KB SRAM window (0x20000000..0x20070000)" if img["region"] == "SRAM"
                 else "the 8 MB PSRAM window")
        bump("error"); msgs.append("error", f"{img['region']} image extends {img['extent'] / KB:.1f} KB, beyond {where}")
    if mem["ram"]["used"] > mem["ram"]["limit"]:
        bump("error"); msgs.append("error", f"static SRAM use {mem['ram']['used'] / KB:.1f} KB exceeds "
                                   f"{mem['ram']['limit'] / KB:.0f} KB")
    if mem["psram"]["used"] > mem["psram"]["limit"]:
        bump("error"); msgs.append("error", "PSRAM use exceeds 8 MB")
    st["core1_launched"] = bool(st["core1"]) or st.get("core1_launch_sites", 0) > 0
    s, m, budget = stack_budget(elf, mem, st)
    bump(s); msgs.extend(m)
    if st["irq_priorities_changed"]:
        msgs.append("note", "the app changes IRQ priorities (" + ", ".join(st["irq_priorities_changed"]) +
                    "): nested interrupts can stack deeper than the figure above")
    return dict(elf=elf_path, status=status, messages=msgs, memory=mem, stack=st, stack_budget=budget)


# --------------------------------------------------------------------- run / web


def _generator():
    return ["-G", "Ninja"] if shutil.which("ninja") else []


def build_one_app(app_dir, build, cmake_args, web=False):
    """Configure the emulator with only APP_DIR and build its target. Returns (target, bin dir)."""
    app_dir, targets = check_app_dir(app_dir)
    target = targets[0]
    if len(targets) > 1:
        print(f"fw2emu: {app_dir} defines {', '.join(targets)}; using {target}", file=sys.stderr)
    if not os.path.isfile(os.path.join(WILIBSP, "bsp", "fw2.h")):
        die("WiliBSP is missing; run: git submodule update --init --recursive")
    cfg = ["cmake", "-S", ROOT, "-B", build] + _generator() + [
        "-DFW2_EMU_UPSTREAM_APPS=", "-DFW2_EMU_LOCAL_APPS=OFF", "-DFW2_EMU_TEST_APPS=OFF",
        f"-DFW2_EMU_EXTRA_APPS={app_dir}"] + cmake_args
    if web:
        cfg = ["emcmake"] + cfg
    if run(cfg, stdout=subprocess.DEVNULL).returncode:
        die("configure failed (run the command above yourself to see why)", 1)
    if run(["cmake", "--build", build, "--target", target]).returncode:
        die("build failed", 1)
    return target, os.path.join(build, "bin")


def cmd_run(a):
    cmake_args, suffix = [], ""
    if a.sanitize:
        cmake_args.append("-DFW2_EMU_SANITIZE=ON"); suffix += "-asan"
    if a.m32:
        cmake_args.append("-DFW2_EMU_32BIT=ON"); suffix += "-m32"
    if a.debug or a.gdb:
        cmake_args.append("-DCMAKE_BUILD_TYPE=Debug"); suffix += "-debug"
    build = os.path.abspath(a.build_dir or os.path.join(ROOT, "build-run" + suffix))
    target, bindir = build_one_app(a.app, build, cmake_args)
    exe = os.path.join(bindir, target)
    args = a.emu_args[1:] if a.emu_args[:1] == ["--"] else a.emu_args
    if a.m32 and "--headless" not in args:
        print("fw2emu: note: the -m32 build has no window unless configured with SDL; adding --headless",
              file=sys.stderr)
        args = ["--headless"] + args
    if (sys.platform.startswith("linux") and "--headless" not in args
            and not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY")):
        print("fw2emu: note: no display here (e.g. a Codespace), so running --headless. Drive it with "
              "--script / --rtt and save the screen with --shot-on-exit, or use `tools/fw2emu web APP_DIR`.",
              file=sys.stderr)
        args = ["--headless"] + args
    cmd = ["gdb", "-q", "-ex", "break fw2_emu_app_main", "--args", exe] + args if a.gdb else [exe] + args
    if a.gdb and not shutil.which("gdb"):
        die("gdb not found")
    print("+ " + " ".join(cmd), file=sys.stderr, flush=True)
    os.execvp(cmd[0], cmd)


class _Handler(http.server.SimpleHTTPRequestHandler):
    extensions_map = dict(http.server.SimpleHTTPRequestHandler.extensions_map,
                          **{".wasm": "application/wasm", ".js": "text/javascript"})

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()


def cmd_web(a):
    if not shutil.which("emcc") or not shutil.which("emcmake"):
        die("emcc not found. Install and activate Emscripten (the project uses 4.0.15):\n"
            "  git clone https://github.com/emscripten-core/emsdk.git ~/emsdk\n"
            "  ~/emsdk/emsdk install 4.0.15 && ~/emsdk/emsdk activate 4.0.15\n"
            "  source ~/emsdk/emsdk_env.sh\n"
            "or build the Docker image instead (see README).")
    build = os.path.abspath(a.build_dir or os.path.join(ROOT, "build-web-run"))
    target, bindir = build_one_app(a.app, build, ["-DCMAKE_BUILD_TYPE=Release"], web=True)
    args = a.emu_args[1:] if a.emu_args[:1] == ["--"] else a.emu_args
    query = {"app": target}
    if args:
        query["args"] = " ".join(args)
    url = f"http://127.0.0.1:{a.port}/?{urllib.parse.urlencode(query, quote_via=urllib.parse.quote)}"
    if a.no_serve:
        print(f"built {os.path.join(bindir, target)}.js; serve {bindir} and open {url}")
        return 0
    handler = functools.partial(_Handler, directory=bindir)
    try:
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", a.port), handler)
    except OSError as e:
        die(f"cannot listen on 127.0.0.1:{a.port}: {e} (try --port)")
    print(f"\nServing {bindir}\nOpen {url}\nCtrl-C to stop.", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


# --------------------------------------------------------------------- hwcheck


def cmd_hwcheck(a):
    apps = a.apps or default_apps()
    dirs = []
    names = {}
    for d in apps:
        d, targets = check_app_dir(d)
        base = os.path.basename(d)
        if base in names and names[base] != d:
            die(f"two apps share the folder name '{base}': {names[base]} and {d}")
        names[base] = d
        dirs.append((d, targets))
    if a.exclude:
        drop = set(a.exclude)
        dirs = [(d, t) for d, t in dirs if os.path.basename(d) not in drop and not drop & set(t)]
        if not dirs:
            die("--exclude left no apps to check")
    need_onewili()
    bindir = find_toolchain(a.toolchain, fetch=a.fetch_toolchain)
    gv = gcc_version(bindir)
    if not gv.startswith("14.2") and not a.json:
        print(f"fw2emu: note: arm-none-eabi-gcc {gv}; WiliBSP builds with Arm GNU Toolchain 14.2.Rel1, so sizes "
              "can differ slightly (--fetch-toolchain downloads it)", file=sys.stderr)
    sdk = find_sdk(a.sdk)
    build = os.path.abspath(a.build_dir)
    os.makedirs(build, exist_ok=True)

    cfg = ["cmake", "-S", os.path.join(ROOT, "hwcheck"), "-B", build, "-G", "Ninja",
           f"-DPICO_SDK_PATH={sdk}", "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
           f"-DWILIBSP_DIR={WILIBSP}",
           "-DFW2_HW_APPS=" + ";".join(d for d, _ in dirs)]
    tc_root = os.path.dirname(bindir) if os.path.basename(bindir) == "bin" else bindir
    if not shutil.which("arm-none-eabi-gcc") or os.path.realpath(shutil.which("arm-none-eabi-gcc")) != \
            os.path.realpath(os.path.join(bindir, "arm-none-eabi-gcc")):
        cfg.append(f"-DPICO_TOOLCHAIN_PATH={tc_root}")
    # Reuse one picotool build across build directories (the SDK otherwise
    # builds it from source for every fresh configure).
    pt = os.path.expanduser(f"~/.pico-sdk/picotool/{PICO_SDK_VERSION}/picotool")
    cached_pt = os.path.join(CACHE, "picotool")
    if os.path.isfile(os.path.join(pt, "picotoolConfig.cmake")):
        cfg.append(f"-Dpicotool_DIR={pt}")
    elif os.path.isfile(os.path.join(cached_pt, "picotool", "picotoolConfig.cmake")):
        cfg.append(f"-Dpicotool_DIR={os.path.join(cached_pt, 'picotool')}")
    else:
        cfg.append(f"-DPICOTOOL_FETCH_FROM_GIT_PATH={cached_pt}")
    out = subprocess.DEVNULL if a.json else None
    if run(cfg, stdout=out).returncode:
        die("configure failed", 1)
    log_path = os.path.join(build, "hwcheck-build.log")
    with open(log_path, "w") as log:
        p = run(["cmake", "--build", build, "--", "-k", "0"], stdout=log, stderr=subprocess.STDOUT)
    with open(log_path, errors="replace") as f:
        build_log = f.read()
    if p.returncode and not a.json:
        print(f"fw2emu: build reported errors (full log: {log_path})", file=sys.stderr)

    failed = ninja_failures(build_log) if p.returncode else {}
    results = []
    for d, targets in dirs:
        base = os.path.basename(d)
        mine = [ln for out, lines in failed.items() if f"apps/{base}/" in out for ln in lines]
        shared = [ln for out, lines in failed.items() if "apps/" not in out for ln in lines]
        for t in targets:
            elf = os.path.join(build, "apps", base, t + ".elf")
            r = dict(app=t, dir=d)
            why = mine if mine else shared
            if why or not os.path.exists(elf):
                errs = meaningful_errors(why)
                if not os.path.exists(elf):
                    msgs = Messages()
                    msgs.append("error", f"build failed; full log: {log_path}")
                    r.update(status="error", messages=msgs, build_errors=errs)
                    results.append(r)
                    continue
                # Linked, but a post-link check (e.g. WiliBSP's check_app_uf2.py or an
                # app's own verify script) failed: report the sizes as well.
                r.update(check_elf(elf, build, bindir))
                r["status"] = "error"
                r["build_errors"] = errs
                r["messages"].insert(0, dict(level="error", text=f"a post-link check failed; full log: {log_path}"))
            else:
                r.update(check_elf(elf, build, bindir))
            results.append(r)

    meta = dict(pico_sdk=sdk_version(sdk), pico_sdk_path=sdk, gcc=gcc_version(bindir),
                build_dir=build, wilibsp_pinned_toolchain=PICO_TOOLCHAIN_VERSION)
    if a.json:
        json.dump(dict(tool=meta, apps=results), sys.stdout, indent=2, default=str)
        print()
    else:
        print_table(meta, results, a.verbose)
    if a.output:
        with open(a.output, "w") as f:
            json.dump(dict(tool=meta, apps=results), f, indent=2, default=str)
    return 1 if any(r["status"] == "error" for r in results) else 0


def ninja_failures(log):
    """{FAILED line: [output lines]} from a ninja log, without the (long) command line."""
    out, cur, skip = {}, None, False
    for ln in log.splitlines():
        if ln.startswith("FAILED: "):
            cur, skip = ln, True
            out[cur] = []
        elif re.match(r"^\[\d+/\d+\] ", ln) or ln.startswith("ninja: "):
            cur = None
        elif cur:
            if skip:            # ninja prints the command right after FAILED:
                skip = False
                continue
            out[cur].append(ln)
    return out


# Normal output of WiliBSP's post-link steps, not errors.
_NORMAL = re.compile(r"^(app UF2 target:|FW2 app:|Generating |layout check: PSRAM app \+)")
_ERROR = re.compile(r"\berror\b|Error:|overflow|undefined reference|multiple definition|cannot find|"
                    r"No such file|layout check:|not in |outside|\bfailed\b|Exception|SystemExit", re.I)


def meaningful_errors(lines, limit=10):
    """The compiler / linker / script error lines of a failed step."""
    keep = []
    for ln in lines:
        t = ln.strip()
        if not t or _NORMAL.match(t) or t.startswith(("Traceback", "File \"", "raise ", "^")):
            continue
        if _ERROR.search(t) and t not in keep:
            keep.append(t if len(t) <= 300 else t[:297] + "...")
    if not keep:
        keep = [ln.strip()[:300] for ln in lines if ln.strip() and not _NORMAL.match(ln.strip())][-5:]
    return keep[:limit]


def _pct(n, d):
    return f"{100.0 * n / d:3.0f}%" if d else ""


def _kb(n):
    return f"{n / KB:.1f} KB"


def print_table(meta, results, verbose):
    print(f"\nFREE-WILi 2 hardware check: Pico SDK {meta['pico_sdk']}, arm-none-eabi-gcc {meta['gcc']}"
          f" (WiliBSP's pinned toolchain is {meta['wilibsp_pinned_toolchain']})\n")
    hdr = (f"{'app':<17} {'image (loaded)':>24} {'SRAM (static)':>20} {'PSRAM (all)':>20} "
           f"{'stack':>14} {'unknowns':>9}  status")
    print(hdr)
    print("-" * len(hdr))
    for r in results:
        if "memory" not in r:
            print(f"{r['app']:<17} {'':>24} {'':>20} {'':>20} {'':>14} {'':>9}  BUILD FAILED")
            continue
        m, s = r["memory"], r["stack"]
        img = m["image"]
        img_s = (f"{img['region']} {img['extent'] / KB:6.1f}/{img['limit'] // KB} KB "
                 f"{_pct(img['extent'], img['limit'])}")
        ram_s = f"{m['ram']['used'] / KB:6.1f}/{m['ram']['limit'] // KB} KB {_pct(m['ram']['used'], m['ram']['limit'])}"
        ps = m["psram"]["used"]
        ps_s = f"{ps / KB:6.1f}/{m['psram']['limit'] // KB} KB {_pct(ps, m['psram']['limit'])}" if ps else "-"
        b = r["stack_budget"]
        lim = b["limit"]
        st_s = f"{s['combined']}/{lim // KB} KB" if lim >= 16 * KB else f"{s['combined']}/{lim} B"
        unk = stackcheck.count_unknown(s["main"]["unknown"])
        for h in s["irq"]:
            unk += stackcheck.count_unknown(h["unknown"])
        print(f"{r['app']:<17} {img_s:>24} {ram_s:>20} {ps_s:>20} {st_s:>14} {unk:>9}  {r['status'].upper()}")
    print()
    for r in results:
        print(f"{r['app']}  ({r['dir']})")
        if "memory" not in r:
            _print_messages(r)
            print()
            continue
        m, s = r["memory"], r["stack"]
        img, ram = m["image"], m["ram"]
        bd = img["breakdown"]
        if img["region"] == "PSRAM":
            parts = ", ".join(f"{k} {v}" for k, v in (("code", bd.get("code", 0)), ("rodata", bd.get("rodata", 0)),
                                                      ("SRAM bootstrap", bd.get("bootstrap", 0)),
                                                      ("data", bd.get("data", 0))) if v)
            print(f"  PSRAM image {img['bytes']} B ({parts}) in the 8 MB window (fw2_psram_app)")
            if img["copied_to_sram"]:
                print("  copied to SRAM at start-up: " +
                      ", ".join(f"{n} {v} B" for n, v in img["copied_to_sram"].items()))
        else:
            print(f"  SRAM image {img['bytes']} B (code {bd.get('code', 0)}, rodata {bd.get('rodata', 0)}, "
                  f"data {bd.get('data', 0)})")
        rb = ram["breakdown"]
        parts = ", ".join(f"{k} {v}" for k, v in (("bootstrap", rb.get("bootstrap", 0)), ("code", rb.get("code", 0)),
                                                  ("rodata", rb.get("rodata", 0)), ("data", rb.get("data", 0)),
                                                  ("bss", rb.get("bss", 0)), ("heap reserve", rb.get("heap", 0))) if v)
        print(f"  SRAM in use {ram['used']} B ({parts})"
              + (f"; malloc can use {_kb(ram['heap_free'])}" if ram["heap_free"] and s.get("uses_malloc") else ""))
        if m["psram"]["used"]:
            print(f"  PSRAM {m['psram']['load']} B loaded + {m['psram']['noload']} B NOLOAD")
        b = r["stack_budget"]
        if b["region"] == "SRAM":
            where = (f"stack grows down from 0x{b['top']:08x} (WiliBSP's PSRAM link) into the "
                     f"{_kb(b['limit'])} above static SRAM" + (", shared with malloc" if s.get("uses_malloc") else ""))
        else:
            where = f"stack grows down from 0x{b['top']:08x} through the {b['limit']} B of SCRATCH_Y"
        wi = next((h for h in s["irq"] if h["name"] == s["worst_irq"]), None)
        print(f"  stack {s['combined']} B = {s['main'].get('root', 'main')} {s['main']['bytes']} B"
              f" + exception entry {s['exception_frame']} B"
              + (f" + IRQ {wi['bytes']} B ({wi['name']}, {wi['kind']})" if wi else " (no IRQ handlers found)"))
        print(f"    {where}")
        print(f"    thread: {stackcheck.format_path(s['main']['path'], 8 if not verbose else 100)}")
        if wi and verbose:
            print(f"    IRQ:  {stackcheck.format_path(wi['path'], 100)}")
        if verbose:
            for h in s["irq"]:
                print(f"    {h['kind']:<9} {h['bytes']:5d} B  {h['name']}")
        u = s["main"]["unknown"]
        if verbose:
            for ln in stackcheck.format_unknown(u, "    ", limit=1000):
                print(ln)
            for h in s["irq"]:
                for ln in stackcheck.format_unknown(h["unknown"], f"    [{h['name']}] ", limit=1000):
                    print(ln)
        else:
            parts = [f"{len(u[k])} {label}" for k, label in
                     (("indirect", "with indirect calls"), ("recursion", "recursion cycles"),
                      ("dynamic", "dynamic frames"), ("no_info", "without stack info"),
                      ("estimated", "estimated from disassembly")) if u.get(k)]
            if parts:
                print("    lower bound: " + ", ".join(parts) + "  (-v lists them)")
        for c in s["core1"]:
            print(f"  core 1: {c['bytes']} B  {stackcheck.format_path(c['path'], 8)}")
        _print_messages(r)
        print()


def _print_messages(r):
    errs = r.get("build_errors", [])
    for i, msg in enumerate(r.get("messages", [])):
        print(f"  {msg['level'].upper()}: {msg['text']}")
        if i == 0 and errs:              # the build-failure message comes first
            for ln in errs:
                print(f"      {ln}")


# --------------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(prog="fw2emu", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="build one app folder for the emulator and run it",
                       description="Build APP_DIR (any folder with a fw2_display_app() CMakeLists.txt) "
                                   "against the emulator and run it. Everything after APP_DIR goes to the "
                                   "emulator (e.g. --headless --script FILE --rtt).")
    r.add_argument("app", metavar="APP_DIR")
    r.add_argument("emu_args", nargs=argparse.REMAINDER, metavar="EMULATOR FLAGS")
    r.add_argument("--build-dir", help="default: build-run/ (build-run-asan/ etc. with the options below)")
    r.add_argument("--sanitize", action="store_true", help="ASan + UBSan build (FW2_EMU_SANITIZE)")
    r.add_argument("--m32", action="store_true", help="32-bit build (FW2_EMU_32BIT), headless")
    r.add_argument("--debug", action="store_true", help="CMAKE_BUILD_TYPE=Debug")
    r.add_argument("--gdb", action="store_true", help="Debug build, run under gdb, break in the app's main")
    r.set_defaults(func=cmd_run)

    w = sub.add_parser("web", help="build one app folder for the browser and serve it locally",
                       description="Build APP_DIR with Emscripten (emcc must be on PATH) and serve the page "
                                   "on 127.0.0.1. Flags after APP_DIR are passed to the emulator (?args=).")
    w.add_argument("app", metavar="APP_DIR")
    w.add_argument("emu_args", nargs=argparse.REMAINDER, metavar="EMULATOR FLAGS")
    w.add_argument("--build-dir", help="default: build-web-run/")
    w.add_argument("--port", type=int, default=8080, help="default: 8080")
    w.add_argument("--no-serve", action="store_true", help="build only")
    w.set_defaults(func=cmd_web)

    h = sub.add_parser("hwcheck", help="build for real hardware and check memory and stack",
                       description="Build apps for the real FREE-WILi 2 with the Pico SDK and Arm GCC and "
                                   "report SRAM image, RAM, PSRAM and worst-case stack. Exits 1 on a hard "
                                   "overflow (image > 448 KB, RAM > 512 KB, stack beyond the scratch banks) "
                                   "or a build failure.")
    h.add_argument("apps", nargs="*", metavar="APP_DIR",
                   help="app folders (default: every app the emulator builds)")
    h.add_argument("--build-dir", default=os.path.join(ROOT, "build-hw"), help="default: build-hw/")
    h.add_argument("--sdk", help="Pico SDK path (default: $PICO_SDK_PATH, ~/.pico-sdk/sdk/2.3.0, "
                                 "else fetched into ~/.cache/fw2emu)")
    h.add_argument("--toolchain", help="Arm GNU toolchain directory (default: $PICO_TOOLCHAIN_PATH, "
                                       "~/.pico-sdk/toolchain/14_2_Rel1, ~/.cache/fw2emu/arm-gnu-toolchain-"
                                       "14.2.rel1-*, else PATH)")
    h.add_argument("--fetch-toolchain", action="store_true",
                   help="if no Arm GNU Toolchain 14.2.Rel1 is found, download it into ~/.cache/fw2emu "
                        "(Linux x86_64/aarch64)")
    h.add_argument("--exclude", action="append", metavar="APP", default=[],
                   help="skip an app (folder or target name); repeatable")
    h.add_argument("--json", action="store_true", help="print JSON instead of the table")
    h.add_argument("-o", "--output", metavar="FILE", help="also write the JSON report to FILE")
    h.add_argument("-v", "--verbose", action="store_true", help="list IRQ handlers and every unknown")
    h.set_defaults(func=cmd_hwcheck)

    a = ap.parse_args()
    sys.exit(a.func(a))


if __name__ == "__main__":
    main()
