# Known failures of WiliBSP's own example apps that come from WiliBSP or its
# libraries, not from the app or from this tool. They are reported as
# "KNOWN (upstream)" and don't change the exit status (--strict makes them
# count). Keyed by (app, kind); they never apply to apps outside WiliBSP.
DOCS = "https://dfdarty.github.io/freewili2-emu"
KNOWN_UPSTREAM = {
    ("hello_psram_exec", "layout"): (
        "WiliBSP's psram_link selects the SRAM-bootstrap objects as *.c.obj (Windows naming); "
        "with *.c.o (Linux/macOS) clock/QMI code lands in PSRAM and verify_layout.py rejects it",
        f"{DOCS}/compatibility/#known-upstream-issues"),
    ("toggleled", "stack"): (
        "every generated OneWili text command keeps ~10 KB of buffers on the stack (libs/onewili)",
        f"{DOCS}/compatibility/#known-upstream-issues"),
    ("hello_vref", "stack"): (
        "every generated OneWili text command keeps ~10 KB of buffers on the stack (libs/onewili)",
        f"{DOCS}/compatibility/#known-upstream-issues"),
}


def failure_kinds(r):
    """Classify a result's error messages: {'stack', 'layout', 'other'}."""
    kinds = set()
    for m in r.get("messages", []):
        if m["level"] != "error":
            continue
        t = m["text"]
        if "stack" in t and ("overflow" in t or "does not fit" in t):
            kinds.add("stack")
        elif t.startswith("a post-link check failed") and any(
                "layout check:" in ln for ln in r.get("build_errors", [])):
            kinds.add("layout")
        else:
            kinds.add("other")
    return kinds


def apply_known_upstream(r, stale):
    """Mark a WiliBSP example's known upstream failures; record entries that no longer occur."""
    d = os.path.realpath(r["dir"])
    if os.path.dirname(d) != os.path.realpath(os.path.join(WILIBSP, "apps")):
        return
    kinds = failure_kinds(r) if r["status"] == "error" else set()
    mine = {k: v for (app, k), v in KNOWN_UPSTREAM.items() if app == r["app"]}
    for k in mine:
        if k not in kinds and "memory" in r:          # it built, and the known failure is gone
            stale.append((r["app"], k))
    if kinds and kinds <= set(mine):
        r["status"] = "known"
        r["known_upstream"] = [dict(kind=k, reason=mine[k][0], docs=mine[k][1]) for k in sorted(kinds)]


def elf_compilers(elf_path):
    """Compiler versions recorded in the linked image's .comment section."""
    try:
        elf = stackcheck.Elf(elf_path)
    except (OSError, ValueError):
        return []
    sec = elf.section(".comment")
    if not sec:
        return []
    raw = elf._data[sec["offset"]:sec["offset"] + sec["size"]].decode("ascii", "replace")
    found = []
    for s in raw.split("\0"):
        m = re.match(r"GCC: \((.*?)\) (\d+\.\d+\.\d+)", s.strip())
        if m and (m.group(2), m.group(1)) not in found:
            found.append((m.group(2), m.group(1)))
    return found


def toolchain_changed(build, gcc_path, version):
    """Record the toolchain in the build folder; wipe the CMake cache if it changed."""
    rec_path = os.path.join(build, "fw2emu-toolchain.json")
    want = dict(gcc=os.path.realpath(gcc_path), version=version)
    cache = os.path.join(build, "CMakeCache.txt")
    old = None
    if os.path.exists(rec_path):
        try:
            with open(rec_path) as f:
                old = json.load(f)
        except (OSError, ValueError):
            old = None
    cached_cc = None
    if os.path.exists(cache):
        with open(cache, errors="replace") as f:
            for ln in f:
                if ln.startswith("CMAKE_C_COMPILER:"):
                    cached_cc = os.path.realpath(ln.split("=", 1)[1].strip())
    # A folder configured before the record existed is judged by its cached compiler.
    changed = os.path.exists(cache) and ((old is not None and old != want) or
                                         (cached_cc is not None and cached_cc != want["gcc"]))
    if changed:
        was = (old or {}).get("gcc") or cached_cc or "?"
        print(f"fw2emu: toolchain changed ({was} -> {want['gcc']}, {version}): "
              f"reconfiguring {build} from scratch", file=sys.stderr)
        os.unlink(cache)
        shutil.rmtree(os.path.join(build, "CMakeFiles"), ignore_errors=True)
    return rec_path, want


def cmd_hwcheck(a):
    apps = a.apps or default_apps()
    dirs = []
    names = {}
    for d in apps:
        d, targets = check_app_dir(d)
        base = os.path.basename(d)
        if base in names and names[base] != d:
            die(f"two apps share the folder name '{base}': {names[base]} and {d}")
        names[base] = d
        dirs.append((d, targets))
    if a.exclude:
        drop = set(a.exclude)
        dirs = [(d, t) for d, t in dirs if os.path.basename(d) not in drop and not drop & set(t)]
        if not dirs:
            die("--exclude left no apps to check")
    need_onewili()
    bindir = find_toolchain(a.toolchain, fetch=a.fetch_toolchain)
    gv = gcc_version(bindir)
    if not gv.startswith("14.2") and not a.json:
        print(f"fw2emu: note: arm-none-eabi-gcc {gv}; WiliBSP builds with Arm GNU Toolchain 14.2.Rel1, so sizes "
              "can differ slightly (--fetch-toolchain downloads it)", file=sys.stderr)
    sdk = find_sdk(a.sdk)
    build = os.path.abspath(a.build_dir)
    os.makedirs(build, exist_ok=True)
    rec_path, rec = toolchain_changed(build, os.path.join(bindir, "arm-none-eabi-gcc"), gv)

    cfg = ["cmake", "-S", os.path.join(ROOT, "hwcheck"), "-B", build, "-G", "Ninja",
           f"-DPICO_SDK_PATH={sdk}", "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
           f"-DWILIBSP_DIR={WILIBSP}",
           "-DFW2_HW_APPS=" + ";".join(d for d, _ in dirs)]
    tc_root = os.path.dirname(bindir) if os.path.basename(bindir) == "bin" else bindir
    if not shutil.which("arm-none-eabi-gcc") or os.path.realpath(shutil.which("arm-none-eabi-gcc")) != \
            os.path.realpath(os.path.join(bindir, "arm-none-eabi-gcc")):
        cfg.append(f"-DPICO_TOOLCHAIN_PATH={tc_root}")
    # Reuse one picotool build across build directories (the SDK otherwise
    # builds it from source for every fresh configure).
    pt = os.path.expanduser(f"~/.pico-sdk/picotool/{PICO_SDK_VERSION}/picotool")
    cached_pt = os.path.join(CACHE, "picotool")
    if os.path.isfile(os.path.join(pt, "picotoolConfig.cmake")):
        cfg.append(f"-Dpicotool_DIR={pt}")
    elif os.path.isfile(os.path.join(cached_pt, "picotool", "picotoolConfig.cmake")):
        cfg.append(f"-Dpicotool_DIR={os.path.join(cached_pt, 'picotool')}")
    else:
        cfg.append(f"-DPICOTOOL_FETCH_FROM_GIT_PATH={cached_pt}")
    out = subprocess.DEVNULL if a.json else None
    if run(cfg, stdout=out).returncode:
        die("configure failed", 1)
    with open(rec_path, "w") as f:
        json.dump(rec, f)
    log_path = os.path.join(build, "hwcheck-build.log")
    with open(log_path, "w") as log:
        p = run(["cmake", "--build", build, "--", "-k", "0"], stdout=log, stderr=subprocess.STDOUT)
    with open(log_path, errors="replace") as f:
        build_log = f.read()
    if p.returncode and not a.json:
        print(f"fw2emu: build reported errors (full log: {log_path})", file=sys.stderr)

    failed = ninja_failures(build_log) if p.returncode else {}
    results = []
    for d, targets in dirs:
        base = os.path.basename(d)
        mine = [ln for out, lines in failed.items() if f"apps/{base}/" in out for ln in lines]
        shared = [ln for out, lines in failed.items() if "apps/" not in out for ln in lines]
        for t in targets:
            elf = os.path.join(build, "apps", base, t + ".elf")
            r = dict(app=t, dir=d)
            why = mine if mine else shared
            if why or not os.path.exists(elf):
                errs = meaningful_errors(why)
                if not os.path.exists(elf):
                    msgs = Messages()
                    msgs.append("error", f"build failed; full log: {log_path}")
                    r.update(status="error", messages=msgs, build_errors=errs)
                    results.append(r)
                    continue
                # Linked, but a post-link check (e.g. WiliBSP's check_app_uf2.py or an
                # app's own verify script) failed: report the sizes as well.
                r.update(check_elf(elf, build, bindir))
                r["status"] = "error"
                r["build_errors"] = errs
                r["messages"].insert(0, dict(level="error", text=f"a post-link check failed; full log: {log_path}"))
            else:
                r.update(check_elf(elf, build, bindir))
            results.append(r)

    stale = []
    compilers = []
    for r in results:
        apply_known_upstream(r, stale)
        elf = os.path.join(build, "apps", os.path.basename(r["dir"]), r["app"] + ".elf")
        r["compiler"] = [f"{v} ({label})" for v, label in elf_compilers(elf)]
        for c in elf_compilers(elf):
            if c not in compilers:
                compilers.append(c)
    # The version comes from what was actually linked, not from the tool we meant to use.
    linked = ", ".join(sorted({v for v, _ in compilers})) or gv
    if compilers and gv not in {v for v, _ in compilers}:
        print(f"fw2emu: warning: the images were built by arm-none-eabi-gcc {linked}, "
              f"not {gv} at {bindir}", file=sys.stderr)
    meta = dict(pico_sdk=sdk_version(sdk), pico_sdk_path=sdk, gcc=linked,
                gcc_detail=[f"{v} ({label})" for v, label in compilers], gcc_path=rec["gcc"],
                build_dir=build, wilibsp_pinned_toolchain=PICO_TOOLCHAIN_VERSION,
                strict=bool(a.strict), stale_known_upstream=[f"{app}:{k}" for app, k in stale])
    if a.json:
        json.dump(dict(tool=meta, apps=results), sys.stdout, indent=2, default=str)
        print()
    else:
        print_table(meta, results, a.verbose)
    if a.output:
        with open(a.output, "w") as f:
            json.dump(dict(tool=meta, apps=results), f, indent=2, default=str)
    for app, k in stale:
        msg = (f"known upstream issue {app}:{k} no longer occurs; "
               "remove it from KNOWN_UPSTREAM in tools/fw2emu (and docs/compatibility.md)")
        print(f"fw2emu: warning: {msg}", file=sys.stderr)
        if os.environ.get("GITHUB_ACTIONS") == "true":
            print(f"::warning title=Stale known upstream issue::{msg}")
    bad = {"error", "known"} if a.strict else {"error"}
    return 1 if any(r["status"] in bad for r in results) else 0


def ninja_failures(log):
    """{FAILED line: [output lines]} from a ninja log, without the (long) command line."""
    out, cur, skip = {}, None, False
    for ln in log.splitlines():
        if ln.startswith("FAILED: "):
            cur, skip = ln, True
            out[cur] = []
        elif re.match(r"^\[\d+/\d+\] ", ln) or ln.startswith("ninja: "):
            cur = None
        elif cur:
            if skip:            # ninja prints the command right after FAILED:
                skip = False
                continue
            out[cur].append(ln)
    return out


# Normal output of WiliBSP's post-link steps, not errors.
_NORMAL = re.compile(r"^(app UF2 target:|FW2 app:|Generating |layout check: PSRAM app \+)")
_ERROR = re.compile(r"\berror\b|Error:|overflow|undefined reference|multiple definition|cannot find|"
                    r"No such file|layout check:|not in |outside|\bfailed\b|Exception|SystemExit", re.I)


def meaningful_errors(lines, limit=10):
    """The compiler / linker / script error lines of a failed step."""
    keep = []
    for ln in lines:
        t = ln.strip()
        if not t or _NORMAL.match(t) or t.startswith(("Traceback", "File \"", "raise ", "^")):
            continue
        if _ERROR.search(t) and t not in keep:
            keep.append(t if len(t) <= 300 else t[:297] + "...")
    if not keep:
        keep = [ln.strip()[:300] for ln in lines if ln.strip() and not _NORMAL.match(ln.strip())][-5:]
    return keep[:limit]


def _pct(n, d):
    return f"{100.0 * n / d:3.0f}%" if d else ""


def _kb(n):
    return f"{n / KB:.1f} KB"


def print_table(meta, results, verbose):
    note = ""
    if not str(meta["gcc"]).startswith("14.2"):
        note = f" (WiliBSP builds with Arm GNU Toolchain {meta['wilibsp_pinned_toolchain']})"
    print(f"\nFREE-WILi 2 hardware check: Pico SDK {meta['pico_sdk']}, "
          f"arm-none-eabi-gcc {meta['gcc']}{note}\n")
    # One unit per column: sizes in KB, the stack in bytes.
    head = ["app", "loads into", "image KB", "SRAM KB", "PSRAM KB", "stack B", "unknowns", "status"]
    rows = []
    for r in results:
        if "memory" not in r:
            rows.append([r["app"], "", "", "", "", "", "", "BUILD FAILED"])
            continue
        m, s = r["memory"], r["stack"]
        img, ram, ps = m["image"], m["ram"], m["psram"]
        unk = stackcheck.count_unknown(s["main"]["unknown"])
        for h in s["irq"]:
            unk += stackcheck.count_unknown(h["unknown"])
        lim = r["stack_budget"]["limit"]
        rows.append([
            r["app"], img["region"],
            f"{img['extent'] / KB:.1f} / {img['limit'] // KB} {_pct(img['extent'], img['limit'])}",
            f"{ram['used'] / KB:.1f} / {ram['limit'] // KB} {_pct(ram['used'], ram['limit'])}",
            f"{ps['used'] / KB:.1f} / {ps['limit'] // KB} {_pct(ps['used'], ps['limit'])}" if ps["used"] else "-",
            f"{s['combined']} / {lim} {_pct(s['combined'], lim) if lim > 0 else ''}".rstrip(),
            str(unk),
            "KNOWN (upstream)" if r["status"] == "known" else r["status"].upper(),
        ])
    widths = [max(len(x[i]) for x in [head] + rows) for i in range(len(head))]
    def line(cells):
        out = [cells[0].ljust(widths[0]), cells[1].ljust(widths[1])]
        out += [c.rjust(w) for c, w in zip(cells[2:7], widths[2:7])]
        out.append(cells[7])
        return "  ".join(out)
    print(line(head))
    print("-" * len(line(head)))
    for row in rows:
        print(line(row))
    print()
    for r in results:
        print(f"{r['app']}  ({r['dir']})")
        if "memory" not in r:
            _print_messages(r)
            print()
            continue
        m, s = r["memory"], r["stack"]
        img, ram = m["image"], m["ram"]
        bd = img["breakdown"]
        if img["region"] == "PSRAM":
            parts = ", ".join(f"{k} {v}" for k, v in (("code", bd.get("code", 0)), ("rodata", bd.get("rodata", 0)),
                                                      ("SRAM bootstrap", bd.get("bootstrap", 0)),
                                                      ("data", bd.get("data", 0))) if v)
            print(f"  PSRAM image {img['bytes']} B ({parts}) in the 8 MB window (fw2_psram_app)")
            if img["copied_to_sram"]:
                print("  copied to SRAM at start-up: " +
                      ", ".join(f"{n} {v} B" for n, v in img["copied_to_sram"].items()))
        else:
            print(f"  SRAM image {img['bytes']} B (code {bd.get('code', 0)}, rodata {bd.get('rodata', 0)}, "
                  f"data {bd.get('data', 0)})")
        rb = ram["breakdown"]
        parts = ", ".join(f"{k} {v}" for k, v in (("bootstrap", rb.get("bootstrap", 0)), ("code", rb.get("code", 0)),
                                                  ("rodata", rb.get("rodata", 0)), ("data", rb.get("data", 0)),
                                                  ("bss", rb.get("bss", 0)), ("heap reserve", rb.get("heap", 0))) if v)
        print(f"  SRAM in use {ram['used']} B ({parts})"
              + (f"; malloc can use {_kb(ram['heap_free'])}" if ram["heap_free"] and s.get("uses_malloc") else ""))
        if m["psram"]["used"]:
            print(f"  PSRAM {m['psram']['load']} B loaded + {m['psram']['noload']} B NOLOAD")
        b = r["stack_budget"]
        if b["region"] == "SRAM":
            where = (f"stack grows down from 0x{b['top']:08x} (WiliBSP's PSRAM link) into the "
                     f"{_kb(b['limit'])} above static SRAM" + (", shared with malloc" if s.get("uses_malloc") else ""))
        else:
            where = f"stack grows down from 0x{b['top']:08x} through the {b['limit']} B of SCRATCH_Y"
        wi = next((h for h in s["irq"] if h["name"] == s["worst_irq"]), None)
        print(f"  stack {s['combined']} B = {s['main'].get('root', 'main')} {s['main']['bytes']} B"
              f" + exception entry {s['exception_frame']} B"
              + (f" + IRQ {wi['bytes']} B ({wi['name']}, {wi['kind']})" if wi else " (no IRQ handlers found)"))
        print(f"    {where}")
        print(f"    thread: {stackcheck.format_path(s['main']['path'], 8 if not verbose else 100)}")
        if wi and verbose:
            print(f"    IRQ:  {stackcheck.format_path(wi['path'], 100)}")
        if verbose:
            for h in s["irq"]:
                print(f"    {h['kind']:<9} {h['bytes']:5d} B  {h['name']}")
        u = s["main"]["unknown"]
        if verbose:
            for ln in stackcheck.format_unknown(u, "    ", limit=1000):
                print(ln)
            for h in s["irq"]:
                for ln in stackcheck.format_unknown(h["unknown"], f"    [{h['name']}] ", limit=1000):
                    print(ln)
        else:
            parts = [f"{len(u[k])} {label}" for k, label in
                     (("indirect", "with indirect calls"), ("recursion", "recursion cycles"),
                      ("dynamic", "dynamic frames"), ("no_info", "without stack info"),
                      ("estimated", "estimated from disassembly")) if u.get(k)]
            if parts:
                print("    lower bound: " + ", ".join(parts) + "  (-v lists them)")
        for c in s["core1"]:
            print(f"  core 1: {c['bytes']} B  {stackcheck.format_path(c['path'], 8)}")
        _print_messages(r)
        print()


def _print_messages(r):
    errs = r.get("build_errors", [])
    known = r["status"] == "known"
    for i, msg in enumerate(r.get("messages", [])):
        level = "KNOWN" if known and msg["level"] == "error" else msg["level"].upper()
        print(f"  {level}: {msg['text']}")
        if i == 0 and errs:              # the build-failure message comes first
            for ln in errs:
                print(f"      {ln}")
    for k in r.get("known_upstream", []):
        print(f"  KNOWN upstream issue ({k['kind']}): {k['reason']}")
        print(f"      {k['docs']}")


def cmd_wait_rtt(a):
    """Wait until an emulator started with --rtt is serving RTT."""
    import socket
    import time
    end = time.monotonic() + a.timeout
    while True:
        try:
            socket.create_connection(("127.0.0.1", 9090), timeout=0.5).close()
            print("fw2emu: RTT is up on 127.0.0.1:9090 (DIAG) and :9091 (agentio)", file=sys.stderr)
            return 0
        except OSError:
            if time.monotonic() >= end:
                print(f"fw2emu: nothing is serving RTT on 127.0.0.1:9090 after {a.timeout:.0f} s "
                      "(start the app with --rtt)", file=sys.stderr)
                return 1
            time.sleep(0.2)


# --------------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(prog="fw2emu", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="build one app folder for the emulator and run it",
                       description="Build APP_DIR (any folder with a fw2_display_app() CMakeLists.txt) "
                                   "against the emulator and run it. Everything after APP_DIR goes to the "
                                   "emulator (e.g. --headless --script FILE --rtt).")
    r.add_argument("app", metavar="APP_DIR")
    r.add_argument("emu_args", nargs=argparse.REMAINDER, metavar="EMULATOR FLAGS")
    r.add_argument("--build-dir", help="default: build-run/ (build-run-asan/ etc. with the options below)")
    r.add_argument("--sanitize", action="store_true", help="ASan + UBSan build (FW2_EMU_SANITIZE)")
    r.add_argument("--m32", action="store_true", help="32-bit build (FW2_EMU_32BIT), headless")
    r.add_argument("--debug", action="store_true", help="CMAKE_BUILD_TYPE=Debug")
    r.add_argument("--gdb", action="store_true", help="Debug build, run under gdb, break in the app's main")
    r.add_argument("--build-only", action="store_true",
                   help="build, print the program's path and stop (bin/current-app also points at it)")
    r.set_defaults(func=cmd_run)

    w = sub.add_parser("web", help="build one app folder for the browser and serve it locally",
                       description="Build APP_DIR with Emscripten (emcc must be on PATH) and serve the page "
                                   "on 127.0.0.1. Flags after APP_DIR are passed to the emulator (?args=).")
    w.add_argument("app", metavar="APP_DIR")
    w.add_argument("emu_args", nargs=argparse.REMAINDER, metavar="EMULATOR FLAGS")
    w.add_argument("--build-dir", help="default: build-web-run/")
    w.add_argument("--port", type=int, default=8080, help="default: 8080")
    w.add_argument("--no-serve", action="store_true", help="build only")
    w.set_defaults(func=cmd_web)

    t = sub.add_parser("test", help="build one app folder, run its test script headless and check it",
                       description="Build APP_DIR for the emulator (headless, no SDL needed), run it with its "
                                   "test script (default APP_DIR/test.txt) and check the result: the script's "
                                   "expect lines, and SCRIPT.expect next to the script if there is one (the "
                                   "rules tests/smoke.sh uses). The log, the recorded audio and a fresh SD card "
                                   "folder go to --out. Exit status 0 passed, 1 failed, 2 a mistake in the "
                                   "script or options. Flags after APP_DIR go to the emulator (e.g. "
                                   "--sensor-csv FILE). In GitHub Actions, failures become annotations and a "
                                   "job summary.")
    t.add_argument("app", metavar="APP_DIR")
    t.add_argument("emu_args", nargs=argparse.REMAINDER, metavar="EMULATOR FLAGS")
    t.add_argument("--script", help="default: APP_DIR/test.txt")
    t.add_argument("--out", default="out", help="folder for the log, audio and SD card (default: out/)")
    t.add_argument("--timeout", type=float, default=300, help="seconds before the run is stopped (default 300)")
    t.add_argument("--build-dir", help="default: build-test/ (build-test-asan/ etc.)")
    t.add_argument("--sanitize", action="store_true", help="ASan + UBSan build (FW2_EMU_SANITIZE)")
    t.add_argument("--m32", action="store_true", help="32-bit build (FW2_EMU_32BIT)")
    t.set_defaults(func=cmd_test)

    n = sub.add_parser("new", help="start a new app folder (with a test) from the template",
                       description="Create DIR with a working app (CMakeLists.txt, main.c) and its test "
                                   "(test.txt), named after the folder. With --repo, also a README, a "
                                   ".gitignore and a GitHub workflow that tests every push, for an app "
                                   "that lives in its own repository. Put it in apps/ to have it built "
                                   "with everything else.")
    n.add_argument("dir", metavar="DIR")
    n.add_argument("--name", help="target name (default: the folder name)")
    n.add_argument("--repo", action="store_true", help="also README.md, .gitignore and .github/workflows/fw2emu.yml")
    n.set_defaults(func=cmd_new)

    h = sub.add_parser("hwcheck", help="build for real hardware and check memory and stack",
                       description="Build apps for the real FREE-WILi 2 with the Pico SDK and Arm GCC and "
                                   "report SRAM image, RAM, PSRAM and worst-case stack. Exits 1 on a hard "
                                   "overflow (image > 448 KB, RAM > 512 KB, stack beyond the scratch banks) "
                                   "or a build failure.")
    h.add_argument("apps", nargs="*", metavar="APP_DIR",
                   help="app folders (default: every app the emulator builds)")
    h.add_argument("--build-dir", default=os.path.join(ROOT, "build-hw"), help="default: build-hw/")
    h.add_argument("--sdk", help="Pico SDK path (default: $PICO_SDK_PATH, ~/.pico-sdk/sdk/2.3.0, "
                                 "else fetched into ~/.cache/fw2emu)")
    h.add_argument("--toolchain", help="Arm GNU toolchain directory (default: $PICO_TOOLCHAIN_PATH, "
                                       "~/.pico-sdk/toolchain/14_2_Rel1, ~/.cache/fw2emu/arm-gnu-toolchain-"
                                       "14.2.rel1-*, else PATH)")
    h.add_argument("--fetch-toolchain", action="store_true",
                   help="if no Arm GNU Toolchain 14.2.Rel1 is found, download it into ~/.cache/fw2emu "
                        "(Linux x86_64/aarch64)")
    h.add_argument("--strict", action="store_true",
                   help="known upstream failures of WiliBSP's example apps also count (exit 1)")
    h.add_argument("--exclude", action="append", metavar="APP", default=[],
                   help="skip an app (folder or target name); repeatable")
    h.add_argument("--json", action="store_true", help="print JSON instead of the table")
    h.add_argument("-o", "--output", metavar="FILE", help="also write the JSON report to FILE")
    h.add_argument("-v", "--verbose", action="store_true", help="list IRQ handlers and every unknown")
    h.set_defaults(func=cmd_hwcheck)

    wr = sub.add_parser("wait-rtt", help="wait until an emulator started with --rtt serves RTT",
                        description="Wait until an app started with --rtt (e.g. `fw2emu run APP --rtt &`, which "
                                    "builds first) is serving RTT on 127.0.0.1:9090 and :9091, so WiliBSP's fw.py "
                                    "can be used. Exits 0 when it is, 1 on timeout.")
    wr.add_argument("--timeout", type=float, default=300, help="seconds to wait (default 300: covers a first build)")
    wr.set_defaults(func=cmd_wait_rtt)

    a = ap.parse_args()
    sys.exit(a.func(a))


if __name__ == "__main__":
    main()
